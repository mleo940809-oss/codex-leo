        <mxCell id="10" value="1 入口来源&#xa;进入活动编辑页的来源" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fontColor=#111827;" vertex="1" parent="1">
