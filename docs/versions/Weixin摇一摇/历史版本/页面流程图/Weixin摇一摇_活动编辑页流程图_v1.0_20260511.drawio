        </mxCell>
        <mxCell id="32" value="公共字段区（可编辑）&#xa;活动基础展示信息（名称、时间、说明、规则等）" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="805" y="275" width="470" height="100" as="geometry"/>
        </mxCell>
