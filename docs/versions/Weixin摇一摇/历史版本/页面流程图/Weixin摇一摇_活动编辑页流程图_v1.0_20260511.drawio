          <mxGeometry x="430" y="610" width="320" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="30" value="3 活动编辑页（可编辑）&#xa;券类型已锁定，不可切换" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fontColor=#111827;" vertex="1" parent="1">
