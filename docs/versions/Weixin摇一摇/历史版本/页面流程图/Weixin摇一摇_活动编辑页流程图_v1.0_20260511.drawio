          <mxGeometry x="805" y="385" width="470" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="40" value="4 补全或修订可编辑字段&#xa;完整或修改活动信息" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#16a34a;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1340" y="170" width="360" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="50" value="5 系统校验&#xa;• 字段格式校验&#xa;• 组合关系校验&#xa;• 状态条件校验" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=left;verticalAlign=top;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1340" y="305" width="360" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="51" value="校验不通过&#xa;提示错误并定位字段" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#ef4444;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#dc2626;" vertex="1" parent="1">
          <mxGeometry x="1315" y="515" width="300" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="60" value="6 保存修改&#xa;保存当前修改内容" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#16a34a;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1340" y="560" width="360" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="61" value="7 保存成功&#xa;• 返回活动编辑页&#xa;• 保留在生效前修订链路&#xa;• 不直接进入批次执行链路" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#16a34a;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=left;verticalAlign=top;fontColor=#166534;dashed=1;dashPattern=6 6;" vertex="1" parent="1">
          <mxGeometry x="1340" y="690" width="360" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="70" value="8 取消&#xa;点击【取消】或关闭页面" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7c3aed;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#5b21b6;" vertex="1" parent="1">
          <mxGeometry x="840" y="560" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="71" value="存在未保存的修改内容？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7c3aed;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1140" y="560" width="260" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="72" value="二次确认弹窗&#xa;放弃当前修改并离开页面？" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7c3aed;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#5b21b6;dashed=1;dashPattern=6 6;" vertex="1" parent="1">
          <mxGeometry x="1140" y="740" width="320" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="73" value="直接返回来源页" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#16a34a;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1500" y="740" width="240" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="80" value="说明（重要）&#xa;• 活动编辑页是草稿完成与生效前修订的唯一继续入口。&#xa;• 若活动已进入执行阶段（生效中）或已失效，则不允许编辑。&#xa;• 编辑页不处理 Code 上传、门店关联和批次执行控制。&#xa;• 活动状态变更（如失效）需回到活动详情页或列表页执行。" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3b82f6;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=16;fontStyle=1;align=left;verticalAlign=top;fontColor=#111827;dashed=1;dashPattern=6 6;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="840" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="81" value="编辑页不承接范围&#xa;✕ Code 上传 / 校验&#xa;✕ 门店关联 / 配置&#xa;✕ 批次执行 / 发放" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3b82f6;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=left;verticalAlign=top;fontColor=#111827;dashed=1;dashPattern=6 6;" vertex="1" parent="1">
          <mxGeometry x="910" y="850" width="430" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="82" value="图例说明&#xa;蓝色实线：主流程/前进&#xa;蓝色虚线：返回/回流&#xa;绿色：允许/成功&#xa;红色：阻止/不允许&#xa;紫色：返回/确认" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=16;fontStyle=1;align=left;verticalAlign=top;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1370" y="850" width="430" height="220" as="geometry"/>
        </mxCell>

