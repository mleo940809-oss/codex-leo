        </mxCell>
        <mxCell id="31" value="基础信息区（只读）&#xa;商品券ID / 商品券类型 / 使用模式" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
