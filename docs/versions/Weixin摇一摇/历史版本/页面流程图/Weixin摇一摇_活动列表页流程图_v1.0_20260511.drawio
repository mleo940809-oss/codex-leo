        <mxCell id="10" value="1 进入活动列表页并加载列表&#xa;加载活动列表数据" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
