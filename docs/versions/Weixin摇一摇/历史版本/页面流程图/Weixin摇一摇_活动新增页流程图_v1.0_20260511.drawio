  <diagram id="weixin-add-page-flow" name="活动新增页流程图">
    <mxGraphModel dx="1840" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="2" value="2.1.2 活动新增页 - 页面主流程图（方案2 优化版）" style="text;html=1;align=center;verticalAlign=middle;fontSize=34;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="260" y="18" width="1320" height="54" as="geometry"/>
        </mxCell>

        <!-- top main flow -->
        <mxCell id="10" value="1 进入活动新增页&#xa;从活动列表页点击【新增】" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="170" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="2 显示券类型选择页&#xa;选择要创建的活动券类型" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="230" y="90" width="200" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="3 进入对应创建表单页&#xa;（券类型锁定，不可修改）" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="450" y="90" width="210" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="4 填写创建表单" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="680" y="90" width="260" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="14" value="5 保存草稿&#xa;草稿可跨天恢复" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="960" y="90" width="120" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="6 提交审核前校验（必做）&#xa;必填项校验&#xa;字段格式校验&#xa;字段联动校验&#xa;组合校验" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1100" y="90" width="160" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="16" value="7 提交成功&#xa;发起审批流程" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1280" y="90" width="120" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="17" value="8 返回活动详情页&#xa;状态为【审批中】&#xa;可查看审批进度" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1420" y="90" width="170" height="280" as="geometry"/>
        </mxCell>

        <!-- stage labels -->
        <mxCell id="20" value="阶段一：选择券类型" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=10;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="270" y="360" width="220" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="阶段二：填写并提交" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=10;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1080" y="360" width="220" height="34" as="geometry"/>
        </mxCell>

        <!-- stage 1 detail -->
        <mxCell id="30" value="券类型选择页&#xa;满减券&#xa;兑换券" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="180" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="满减券" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#16a34a;strokeWidth=2;fillColor=#ffffff;arcSize=10;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="140" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="32" value="兑换券" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7c3aed;strokeWidth=2;fillColor=#ffffff;arcSize=10;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#6b21a8;" vertex="1" parent="1">
          <mxGeometry x="80" y="550" width="140" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="33" value="系统检测已有草稿？&#xa;检测到当前账号下存在未提交的活动草稿" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;dashed=1;dashPattern=6 6;fillColor=#ffffff;arcSize=12;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="260" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="34" value="直接跳转至活动编辑页&#xa;继续编辑草稿（不进入新增流程）" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1d4ed8;" vertex="1" parent="1">
          <mxGeometry x="55" y="725" width="230" height="95" as="geometry"/>
        </mxCell>

        <!-- stage 2 detail -->
        <mxCell id="40" value="填写创建表单&#xa;填写活动信息" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=center;verticalAlign=top;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="680" y="430" width="400" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="41" value="公共区字段&#xa;（所有券类型通用）&#xa;• 活动基础信息&#xa;• 活动时间&#xa;• 活动规则&#xa;• 适用范围&#xa;• ……" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=1.5;dashed=1;dashPattern=6 6;fillColor=#ffffff;arcSize=10;fontSize=16;fontStyle=1;align=left;verticalAlign=top;fontColor=#1d4ed8;" vertex="1" parent="1">
          <mxGeometry x="710" y="490" width="165" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="42" value="差异区字段&#xa;（随券类型变化）&#xa;根据所选券类型，&#xa;显示对应差异字段&#xa;• ……" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=1.5;dashed=1;dashPattern=6 6;fillColor=#ffffff;arcSize=10;fontSize=16;fontStyle=1;align=left;verticalAlign=top;fontColor=#1d4ed8;" vertex="1" parent="1">
          <mxGeometry x="900" y="490" width="150" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="43" value="保存草稿" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#16a34a;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1095" y="430" width="120" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="44" value="备注：保存草稿不进入审批流程&#xa;草稿可跨天恢复" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#16a34a;strokeWidth=1.5;fillColor=#ffffff;arcSize=10;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1095" y="540" width="120" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="45" value="提交审核前校验（必做）&#xa;• 必填项校验&#xa;• 字段格式校验&#xa;• 字段联动校验&#xa;• 组合校验" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#ef4444;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;fontColor=#dc2626;" vertex="1" parent="1">
          <mxGeometry x="1240" y="430" width="170" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="46" value="校验通过？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#ef4444;strokeWidth=2;fillColor=#ffffff;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1280" y="655" width="90" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="47" value="校验不通过&#xa;提示错误信息&#xa;定位问题字段&#xa;返回表单页修改后重新提交" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#ef4444;strokeWidth=2;dashed=1;dashPattern=6 6;fillColor=#ffffff;arcSize=12;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontColor=#dc2626;" vertex="1" parent="1">
          <mxGeometry x="1415" y="650" width="170" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="48" value="发起审批流程" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1d4ed8;" vertex="1" parent="1">
          <mxGeometry x="1605" y="430" width="110" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="49" value="状态为【审批中】&#xa;可查看审批进度" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1605" y="590" width="170" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="50" value="返回/关闭页面保护" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7c3aed;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#6b21a8;" vertex="1" parent="1">
          <mxGeometry x="300" y="650" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="51" value="是否存在未保存内容？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7c3aed;strokeWidth=2;fillColor=#ffffff;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="350" y="790" width="140" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="52" value="二次确认弹窗&#xa;退出将丢失当前未保存内容，&#xa;确定要离开吗？" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7c3aed;strokeWidth=2;dashed=1;dashPattern=6 6;fillColor=#ffffff;arcSize=12;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontColor=#6b21a8;" vertex="1" parent="1">
          <mxGeometry x="505" y="780" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="53" value="取消（继续编辑）" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;arcSize=10;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1d4ed8;" vertex="1" parent="1">
          <mxGeometry x="520" y="925" width="90" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="54" value="确认离开（放弃本次新增）" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#ef4444;strokeWidth=2;fillColor=#ffffff;arcSize=10;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;fontColor=#dc2626;" vertex="1" parent="1">
          <mxGeometry x="620" y="925" width="105" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="55" value="草稿恢复（跨天）&#xa;草稿保存后，可在任意时间恢复编辑" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#16a34a;strokeWidth=2;dashed=1;dashPattern=6 6;fillColor=#ffffff;arcSize=12;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="770" y="670" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="56" value="入口：活动列表页&#xa;草稿状态的活动，可点击【编辑】恢复草稿" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#16a34a;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="770" y="800" width="280" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="57" value="进入活动编辑页&#xa;恢复草稿内容，继续完善并提交审核" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#16a34a;strokeWidth=2;fillColor=#ffffff;arcSize=12;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1080" y="800" width="320" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="58" value="说明（范围）&#xa;本流程仅覆盖【首次创建活动】的新增流程，不包含已有草稿的继续编辑场景。&#xa;提交成功后进入审批流程，状态为【审批中】，可在活动详情页查看审批进度。&#xa;保存草稿后可跨天恢复，不会进入审批流程。&#xa;涉及的具体字段规则以各券类型的表单页定义为准。" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;dashed=1;dashPattern=6 6;fillColor=#ffffff;arcSize=12;fontSize=15;fontStyle=1;align=left;verticalAlign=top;fontColor=#1d4ed8;" vertex="1" parent="1">
          <mxGeometry x="30" y="1030" width="740" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="59" value="图例说明&#xa;→ 主流程    ↘ 返回流程    ↓ 条件/分支    绿色=草稿/安全结果&#xa;蓝色=页面/步骤    紫色=返回/保护流程    红色=错误/阻断    橙色=校验/提示" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;dashed=1;dashPattern=6 6;fillColor=#ffffff;arcSize=12;fontSize=15;fontStyle=1;align=left;verticalAlign=top;fontColor=#1d4ed8;" vertex="1" parent="1">
          <mxGeometry x="810" y="1030" width="980" height="140" as="geometry"/>
        </mxCell>

